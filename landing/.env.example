# Optional public contact shown as a mailto link. A valid project-owned privacy
# contact is also required before the form can be activated.
NEXT_PUBLIC_PILOT_CONTACT_EMAIL=

# Server-only pilot enquiry delivery. The form remains hidden and /api/waitlist
# returns 503 until delivery, contact, and explicit approval are configured.
# Set approval to true only after privacy/legal review and Vercel abuse controls.
PILOT_INTAKE_APPROVED=false
PILOT_ENQUIRY_TO_EMAIL=
RESEND_API_KEY=
# Plain address on a sender domain verified in Resend (for example, pilot@your-domain).
RESEND_FROM_EMAIL=

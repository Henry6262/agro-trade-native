# Google Gemini Live — single service for STT + LLM + TTS
# Get at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_key_here

# Daily.co — WebRTC transport (audio room)
# Get at: https://dashboard.daily.co
DAILY_API_KEY=your_daily_key_here
DAILY_API_URL=https://api.daily.co/v1

# App config
APP_ENV=production
LOG_LEVEL=INFO
MAX_SESSION_MINUTES=15

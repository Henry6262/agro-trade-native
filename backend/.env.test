# Test Environment Variables
NODE_ENV=test
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
PORT=4001

# Database (dummy CI-safe value — real DB URL goes in GitHub Secrets only)
DATABASE_URL="postgresql://henry:henry@127.0.0.1:5432/agrotrade_test"

# JWT
JWT_SECRET="ci-test-secret-key"
JWT_EXPIRES_IN=1h

# API
API_PREFIX=api

# Logging
SUPPRESS_LOGS=false

# Test specific
TEST_TIMEOUT=30000
